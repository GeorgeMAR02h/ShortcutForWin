<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ShortcutForWin</AssemblyName>
    <AssemblyTitle>Shortcut for Win</AssemblyTitle>
    <Product>Shortcut for Win</Product>
    <Description>Shortcut for Win</Description>
    <RootNamespace>TaskbarFlyout</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>mouse_icon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="mouse_icon.ico" LogicalName="mouse_icon.ico" />
  </ItemGroup>

</Project>
